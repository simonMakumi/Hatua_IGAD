# ---------------------------------------------------------------------------
# HATUA environment. This file is gitignored. Never commit it.
# ---------------------------------------------------------------------------

# --- Reasoning core -------------------------------------------------------
# Provider-agnostic. Set LLM_PROVIDER to one of: gemini | groq | cerebras |
# openrouter | anthropic. Only the matching key is needed.
LLM_PROVIDER=gemini

# Google AI Studio - free tier, NO credit card required.
# Get one at https://aistudio.google.com/apikey  (takes about 90 seconds)
GEMINI_API_KEY=

# Optional alternatives - any one of these works instead of Gemini.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Humanitarian data (done) ---------------------------------------------
HDX_HAPI_APP_IDENTIFIER=

# --- Delivery -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
AT_USERNAME=sandbox
AT_API_KEY=
AT_USSD_SERVICE_CODE=*384*7899#
DEMO_PHONE_NUMBER=

# SMS provider is pluggable; pending cost research.
SMS_PROVIDER=telegram_only

# --- Localisation ---------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Optional -------------------------------------------------------------
FIRMS_MAP_KEY=

# --- Infrastructure -------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
CONTACT_SALT=
DRY_RUN=true
